# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*

# test coverage
coverage/

# macOS
.DS_Store
*.pem

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# editors
.idea/

# agent tooling (personal, not shared)
.claude/settings.local.json

# local env files
# Expo recommends ignoring only .env*.local, but this repo is public:
# ignore .env too so a stray token can never be committed.
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local design folders
/design/
